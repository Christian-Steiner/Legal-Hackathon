# Copy to backend/.env  (never commit .env)

# true  -> Fedlex ingest reads data/fedlex_cache.json (safe for the demo)
# false -> ingest hits the live SPARQL endpoint
DEMO_MODE=true

# mock | apertus | openai
LLM_PROVIDER=mock

# Swisscom Apertus 1.5 70B (key from https://keymaker.ai-weeks.ch/ -> Swisscom). Swiss-hosted.
APERTUS_API_KEY=
# APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B

# OpenAI (hackathon USD 50 credits)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Supertext translation (optional, key from the Keymaker -> Supertext)
SUPERTEXT_API_KEY=
