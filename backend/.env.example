# Copy to backend/.env  (never commit .env)

# true  -> Fedlex ingest reads data/fedlex_cache.json (safe for the demo)
# false -> ingest hits the live SPARQL endpoint
DEMO_MODE=true

# mock | apertus | openai
LLM_PROVIDER=mock

# Speed: parallel LLM calls, hard request-rate cap (Apertus allows 5 req/s), answer cache.
# The cache (data/llm_cache/, not in git) makes a repeated `make reset` with unchanged
# prompts/data almost instant. Set LLM_CACHE=false to force fresh answers.
# LLM_CONCURRENCY=6
# LLM_MAX_RPS=3
# LLM_CACHE=true

# Swisscom Apertus 1.5 70B (key from https://keymaker.ai-weeks.ch/ -> Swisscom). Swiss-hosted.
APERTUS_API_KEY=
# APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B

# OpenAI (hackathon USD 50 credits)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Supertext translation (optional, key from the Keymaker -> Supertext)
SUPERTEXT_API_KEY=
